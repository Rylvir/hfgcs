# OPTIONAL: Datasette over the message DB, LAN only, read-only. Not required by anything.
# Needs `pip install datasette` in the interpreter's environment. Never route a tunnel to this port.
# Interpreter: deploy/bin/hfgcs-python ($HFGCS_PYTHON, default %h/hfgcs-app/.venv/bin/python).
[Unit]
Description=HFGCS Datasette (optional, LAN only, port 8092)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/hfgcs-app
Environment=HFGCS_PYTHON=%h/hfgcs-app/.venv/bin/python
EnvironmentFile=-%h/.config/hfgcs/datasette.env
ExecStart=%h/hfgcs-app/deploy/bin/hfgcs-python -m datasette serve %h/hfgcs-app/data/hfgcs.db \
    --host 192.168.2.214 --port 8092 --metadata %h/hfgcs-app/datasette/metadata.json \
    --setting sql_time_limit_ms 3000 --setting allow_download off
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
