# Copy to ~/.config/hfgcs/public.env. Read by hfgcs-public.service.
# Deliberately no database or recordings settings: the public page cannot see them.
HFGCS_PUBLIC_DIR=/home/scribe/hfgcs-app/public_site
HFGCS_PUBLIC_HOST=192.168.2.214
HFGCS_PUBLIC_PORT=8091
# Interpreter for the unit (deploy/bin/hfgcs-python). Default: /home/scribe/hfgcs-app/.venv/bin/python
# (Python 3.12 venv). Uncomment to use another one; a systemd drop-in also works (docs/review-ui.md 3.1).
#HFGCS_PYTHON=/home/scribe/hfgcs-app/.venv/bin/python
