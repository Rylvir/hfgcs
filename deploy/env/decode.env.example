# Copy to ~/.config/hfgcs/decode.env (chmod 600). Read by hfgcs-decode.service and
# hfgcs-decode-backfill.service. No secrets in here.
# Review DB that load-decodes writes to (same as HFGCS_DB in review.env). Unset = sidecars only.
HFGCS_DB=/home/scribe/hfgcs-app/data/hfgcs.db
# The recorders' catalog; its "file" paths are relative to its directory.
HFGCS_CATALOG=/home/scribe/hfgcs-app/hfgcs_catalog.jsonl
#HFGCS_RECORDINGS_ROOT=/home/scribe/hfgcs-app
# ASR model and threads. hilltop has 4 cores and other work: 3 threads, and the unit runs at
# Nice=19 / CPUWeight=10, so the recorders and OpenWebRX always win.
HFGCS_DECODE_MODEL=small.en
HFGCS_DECODE_THREADS=3
# Voice gate (silero-vad): clips with less speech than this are skipped as no_voice.
#HFGCS_DECODE_GATE_THRESHOLD=0.3
#HFGCS_DECODE_MIN_SPEECH_S=1.0
# Per-clip wall-time cap = factor x clip length, clamped to [min, max] seconds; over it the
# decode is killed and recorded as a timeout (tried --max-attempts times in all).
#HFGCS_DECODE_TIMEOUT_FACTOR=10
#HFGCS_DECODE_TIMEOUT_MIN_S=120
#HFGCS_DECODE_TIMEOUT_MAX_S=7200
#HFGCS_DECODE_MAX_ATTEMPTS=2
# Watch loop poll interval (s).
#HFGCS_DECODE_POLL_S=30
# State, history and lock files (default ~/.local/state/hfgcs).
#HFGCS_DECODE_STATE_DIR=/home/scribe/.local/state/hfgcs
# Interpreter for deploy/bin/hfgcs-python (default /home/scribe/hfgcs-app/.venv/bin/python).
#HFGCS_PYTHON=/home/scribe/hfgcs-app/.venv/bin/python
