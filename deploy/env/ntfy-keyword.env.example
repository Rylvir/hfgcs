# Copy to ~/.config/hfgcs/ntfy-keyword.env (mode 600).
# You can keep using ntfy-skyking.env instead; the unit loads both.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=your-topic-here
# NTFY_TOKEN=   # only if the topic requires auth
# HFGCS_REVIEW_URL=http://192.168.2.214:8090
HFGCS_DECODES=/home/scribe/hfgcs-app/decodes.jsonl
HFGCS_RECORDINGS=/home/scribe/hfgcs-app/recordings
