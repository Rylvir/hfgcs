# Copy to ~/.config/hfgcs/review.env (chmod 600). Read by hfgcs-review.service.
HFGCS_DB=/home/scribe/hfgcs-app/data/hfgcs.db
HFGCS_RECORDINGS=/home/scribe/hfgcs-app/recordings
# Bind to hilltop's LAN address only (code default is 127.0.0.1; 0.0.0.0 is refused
# unless --allow-all-interfaces is passed).
HFGCS_REVIEW_HOST=192.168.2.214
HFGCS_REVIEW_PORT=8090
# Extra Host headers to accept besides 192.168.2.214:8090 (comma separated), e.g. a LAN name.
#HFGCS_REVIEW_ALLOWED_HOSTS=hilltop:8090,hilltop.lan:8090
# Name recorded in the edit history when the form's name field is left empty.
HFGCS_REVIEW_EDITOR=scribe
# Optional fixed CSRF signing key (any long random string); without it a new key is made at
# each start and open pages need a reload after a restart.
#HFGCS_REVIEW_SECRET=change-me-to-a-long-random-string
# Only if the app is ever put behind Cloudflare Access (it is NOT behind the tunnel today):
#HFGCS_REVIEW_TRUST_CF_ACCESS=1
