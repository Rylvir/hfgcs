#!/bin/sh
# Run the project's Python. Used by the systemd units so the interpreter is not hardcoded:
#   HFGCS_PYTHON  interpreter to use (set in ~/.config/hfgcs/*.env or a unit drop-in)
#   default       $HOME/hfgcs-app/.venv/bin/python (the Python 3.12 venv on hilltop)
set -eu
py="${HFGCS_PYTHON:-${HOME}/hfgcs-app/.venv/bin/python}"
if [ ! -x "$py" ]; then
    echo "hfgcs-python: interpreter not found or not executable: $py (set HFGCS_PYTHON)" >&2
    exit 127
fi
exec "$py" "$@"
